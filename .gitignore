# Dependencies
node_modules/

# Environment files (secrets never go in source control)
.env
.env.*
!.env.example

# Encrypted attachment blobs of a local API (ATTACHMENT_STORAGE=local)
apps/api/data/

# Logs
*.log
npm-debug.log*
logs/

# Test / coverage output
coverage/

# Expo / React Native
.expo/
dist/
web-build/
expo-env.d.ts
apps/mobile/android/
apps/mobile/ios/
# Gradle/CMake output of local native modules
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/android/.gradle/
apps/mobile/modules/*/android/.cxx/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
!debug.keystore
google-services.json
google-service.json
GoogleService-Info.plist
