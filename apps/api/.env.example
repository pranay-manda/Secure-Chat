# Copy to apps/api/.env for local development. Never commit .env.

NODE_ENV=development
# 0.0.0.0 lets a phone on your LAN reach the dev API; use 127.0.0.1 to stay local-only.
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug

# MongoDB Atlas (Database > Connect > Drivers). Include the database name (/securechat).
# URL-encode special characters in the password. Your IP must be in Atlas Network Access.
# Use a least-privilege database user (readWrite on the app database only).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/securechat?retryWrites=true&w=majority&appName=<app-name>

# Redis Cloud (Database > Connect). Prefer rediss:// (TLS) once TLS is enabled on the database.
REDIS_URL=redis://default:<redis_password>@<redis-host>:<port>

# Comma-separated browser origins (leave empty: the native app sends no Origin).
CORS_ORIGINS=
# Reverse-proxy hops to trust for client IPs (0 locally, usually 1 behind a load balancer).
TRUST_PROXY_HOPS=0

HEALTH_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# --- Auth (Phase 1) ---
# Two different random secrets (>= 32 chars) per environment. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<generate-a-random-secret>
OTP_HMAC_SECRET=<generate-a-different-random-secret>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# console = OTP printed in the API terminal (development only; refused in production)
# none    = phone sign-in switched off until a real SMS provider is added
SMS_PROVIDER=console

# --- Realtime (Pusher Channels): set all four or none ---
# Pusher dashboard > your Channels app > App Keys. Client events are not needed.
# Without Pusher, messages still arrive through sync (GET /messages/envelopes), just slower.
# PUSHER_SECRET stays on the server only; the app receives just the key and cluster.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# --- Push notifications ---
# expo = Expo push service, which delivers through FCM V1 using the service account uploaded to
# the EAS project (no Firebase key on this server). none = no push notifications.
PUSH_PROVIDER=expo
# Only if "enhanced push security" is enabled for the Expo project (expo.dev > Access tokens).
# EXPO_ACCESS_TOKEN=
# Push only if the device has not acknowledged the message over Pusher within this time.
PUSH_NOTIFY_DELAY_MS=3000

# --- Email OTP ---
# smtp    = send real emails through an SMTP server (needs the four SMTP_* values below)
# console = OTP printed in the API terminal (development only; refused in production)
# none    = email sign-in switched off
EMAIL_PROVIDER=smtp
# SMTP server. TLS is always used and certificates are verified: port 587 = STARTTLS (required),
# port 465 = TLS from the start. Plain-text SMTP is never used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# The SMTP account. For Gmail: the full Gmail address, and an App Password as SMTP_PASS
# (Google Account > Security > 2-Step Verification must be on > App passwords; paste the
# 16 characters without spaces). The normal Gmail password does not work.
# Never commit or share SMTP_PASS. Gmail sends about 500 emails/day (Workspace about 2,000).
SMTP_USER=
SMTP_PASS=
# Optional sender shown to users; defaults to SMTP_USER. With Gmail it must be the account's
# own address or an alias added in Gmail, e.g. CipherChat <you@gmail.com>
SMTP_FROM=

# --- Presence (online status) ---
# A device is shown online while it keeps sending heartbeats (every 20 s while the app is on
# screen and connected); it is forgotten this many seconds after the last one. Redis only.
PRESENCE_TTL_SECONDS=45

# --- Attachments (encrypted photos, videos, voice notes) ---
# The phone encrypts every file before upload; storage only ever holds encrypted blobs.
# local = blobs on this server's disk, transferred through short-lived signed URLs served by
#         this API. Fine for development and for ONE API instance with a persistent disk.
#         (An S3-compatible driver for Cloudflare R2 / AWS S3 is the planned production option.)
ATTACHMENT_STORAGE=local
# Where `local` keeps the blobs (relative to the API's working directory). Never commit it.
ATTACHMENT_STORAGE_DIR=./data/attachments
# How often expired blobs are deleted (0 = never; not recommended).
ATTACHMENT_SWEEP_INTERVAL_SECONDS=600

# --- Voice calls (WebRTC: the API relays signaling only, never audio) ---
# Unanswered calls end as missed after this many seconds; answered calls are cleaned up after
# CALL_MAX_DURATION_SECONDS at the latest.
CALL_RING_TIMEOUT_SECONDS=45
CALL_MAX_DURATION_SECONDS=14400
# STUN servers (comma-separated stun:host:port). Leave commented out to use the default public
# Google STUN server (development only; in production use your own, e.g. the TURN host's).
# STUN_URLS=stun:<your-stun-host>:3478
# TURN relay, coturn "TURN REST API" (use-auth-secret / static-auth-secret). Set both or neither;
# leave both commented out to run without TURN.
#   TURN_URLS   comma-separated turn:/turns: URLs. Never put a user name or password in them:
#               they are sent to every phone.
#   TURN_SECRET the same random value as static-auth-secret on the TURN server (>= 32 chars,
#               different from JWT_ACCESS_SECRET and OTP_HMAC_SECRET)
# The API mints a short-lived credential per call; the secret itself never leaves the server.
# TURN_URLS=turn:<your-turn-host>:3478?transport=udp,turns:<your-turn-host>:5349
# TURN_SECRET=
# Must be >= CALL_RING_TIMEOUT_SECONDS + CALL_MAX_DURATION_SECONDS.
TURN_CREDENTIAL_TTL_SECONDS=18000
# all = direct when possible, TURN as fallback. relay = always through TURN (hides IP addresses
# from the other phone; use it to prove the TURN server works). relay needs TURN.
ICE_TRANSPORT_POLICY=all
