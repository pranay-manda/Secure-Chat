# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are bundled into the app: NEVER put secrets here.
#
# Android emulator:  http://10.0.2.2:4000
# iOS simulator:     http://127.0.0.1:4000
# Physical device:   http://<your-computer-LAN-IP>:4000  (same Wi-Fi; API HOST must be 0.0.0.0)
# Release builds must use https://.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
